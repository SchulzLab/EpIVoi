.git
.gitignore
.Renviron
.Rhistory
.RData
.Rproj.user
*.backup
*.log
*.pdf
*.png
*.rds
*.fa
*.fa.gz
*.bed
*.bed.gz
*.tsv.gz
*.txt.gz
example_input_files/
epivoi_object/data/
docker_data/
docker_resources/
docker_bin/
.nfs*

# Generated analysis outputs
tf_pastaa_app_files/
fimo/
shap_bw/

# Local files and backups
*.backup
*.backup.*
*.bak

# Include the complete preconfigured example and Docker resources.
!example_input_files/
!example_input_files/**
!docker_example/
!docker_example/**

# Rebuild the expanded FASTA and its index inside Docker.
example_input_files/*.fa
example_input_files/*.fa.fai

# Exclude backup copies.
*.before_ready_example

# Explicitly include all bundled example inputs
!example_input_files/
!example_input_files/**
!docker_example/
!docker_example/**

# The expanded genome and index are generated during image build
example_input_files/example_genome_sparse.fa
example_input_files/example_genome_sparse.fa.fai
