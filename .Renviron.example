# RefSeq annotation used for genomic/PDF annotation
EPIVOI_REFSEQ_FILE=/path/to/ncbiRefSeq.txt.gz

# Directory containing igv.min.js and igv.min.css
EPIVOI_IGV_ASSETS_DIR=/path/to/igv

# PASTAA / TRAP executables
EPIVOI_TRAP_BIN=/path/to/TRAP
EPIVOI_PASTAA_BIN=/path/to/PASTAA

# Binding-energy matrix used by TRAP / PASTAA
EPIVOI_PASTAA_ENERGY_MATRIX=/path/to/binding_energy_matrix.txt

# Reference genome
EPIVOI_GENOME_FASTA=/path/to/hg38.fa

# Motif database used by FIMO
EPIVOI_MEME_MOTIF_FILE=/path/to/motifs.meme

# Background resource used by FIMO
EPIVOI_FIMO_ENCODE_BG=/path/to/fimo_background.txt

# Optional
# EPIVOI_PASTAA_CORES=4
